FROM debian:bookworm-slim

LABEL image.author.name="Peter Schneider"
LABEL image.author.email="peter.schneider@student.uni-tuebingen.de"

# Install dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Download and install Salmon
RUN curl -L https://github.com/COMBINE-lab/salmon/releases/download/v1.5.2/salmon-1.5.2_linux_x86_64.tar.gz \
    -o salmon.tar.gz && \
    mkdir -p /opt/salmon && \
    tar -xzf salmon.tar.gz -C /opt/salmon --strip-components=1 && \
    rm salmon.tar.gz


# Set the PATH environment variable (to /usr/bin)
ENV PATH="/opt/salmon/bin:${PATH}"
